{
  "name": "modern-sports-intelligence",
  "private": true,
  "version": "4.3.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e",
    "build:size": "vite build && node scripts/bundle-size.cjs",
    "size:check": "node scripts/bundle-size.cjs --max=3030000",
    "preview": "vite preview",
    "prepare": "husky",
    "lint": "eslint --rule \"no-unused-vars: off\" vite.config.ts playwright.config.ts \"api/**/*.ts\" \"components/**/*.{ts,tsx}\" \"pages/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"contexts/**/*.{ts,tsx}\" \"hooks/**/*.{ts,tsx}\" \"features/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" App.tsx index.tsx constants.tsx",
    "lint:fix": "eslint --rule \"no-unused-vars: off\" vite.config.ts playwright.config.ts \"api/**/*.ts\" \"components/**/*.{ts,tsx}\" \"pages/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"contexts/**/*.{ts,tsx}\" \"hooks/**/*.{ts,tsx}\" \"features/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" App.tsx index.tsx constants.tsx --fix",
    "lint:errors": "eslint --rule \"no-unused-vars: off\" --quiet vite.config.ts playwright.config.ts \"api/**/*.ts\" \"components/**/*.{ts,tsx}\" \"pages/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"contexts/**/*.{ts,tsx}\" \"hooks/**/*.{ts,tsx}\" \"features/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" App.tsx index.tsx constants.tsx",
    "format": "prettier --write \"docs/**/*.md\" \".github/workflows/*.yml\" \"*.json\"",
    "format:check": "prettier --check \"docs/**/*.md\" \".github/workflows/*.yml\" \"*.json\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:rls": "node scripts/run-rls-checks.mjs",
    "audit:high": "npm audit --audit-level=high",
    "test:watch": "vitest",
    "typecheck": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit -p tsconfig.release.json",
    "typecheck:strict": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit -p tsconfig.strict.json",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/auth.spec.ts tests/e2e/dashboard.spec.ts tests/e2e/release-smoke.spec.ts tests/e2e/billing-checkout.spec.ts tests/e2e/command-palette.spec.ts tests/e2e/header-bell.spec.ts tests/e2e/audit-trail.spec.ts --project=chromium --workers=2",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts --project=chromium",
    "test:visual": "playwright test tests/e2e/visual-smoke.spec.ts --project=chromium",
    "test:visual:update": "playwright test tests/e2e/visual-smoke.spec.ts --project=chromium --update-snapshots",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:desktop": "playwright test --project=chromium",
    "test:e2e:mobile": "playwright test --project=Mobile Chrome",
    "test:e2e:pricing-truth": "playwright test tests/e2e/pricing-truth-coverage.spec.ts --project=chromium",
    "test:e2e:deployed": "playwright test tests/e2e/deployed-api.spec.ts --project=chromium --workers=1",
    "test:e2e:real-auth": "cross-env PLAYWRIGHT_REAL_AUTH=1 playwright test tests/e2e/real-auth-smoke.spec.ts --project=chromium --workers=1",
    "test:e2e:gdpr": "playwright test tests/e2e/gdpr-endpoints.spec.ts --project=chromium --workers=1",
    "test:smoke:routes": "node scripts/smoke-all-tabs.cjs",
    "audit:localstorage": "node scripts/audit-localstorage.mjs",
    "deploy:infra": "node scripts/deploy-production.mjs",
    "deploy:infra:dry": "node scripts/deploy-production.mjs --dry-run",
    "verify:rls": "node scripts/rls-verify.mjs",
    "guardrail:pricing-truth": "node scripts/check-pricing-truth-guardrail.mjs",
    "check:prod-env": "node scripts/check-production-env.mjs",
    "sync:vercel-env": "node scripts/sync-vercel-supabase-env.mjs",
    "ops:bootstrap-launch": "node scripts/bootstrap-launch-ops.mjs",
    "ops:promote-admin": "node scripts/promote-admin.mjs",
    "ops:check-real-data": "node scripts/check-real-data-ready.mjs",
    "ci:bundle": "node scripts/ci-bundle-gate.cjs",
    "perf:audit": "npm run build --silent && bash -c 'set -o pipefail; npm run ci:bundle --silent | grep -E \"^(Total:|✅|❌|OVER BUDGET)\"'",
    "joe": "tsx scripts/orchestrator.ts",
    "joe:batch": "tsx scripts/batch-builder.ts",
    "joe:validate": "tsx scripts/feature-validator.ts",
    "joe:diff": "tsx scripts/feature-diff.ts",
    "joe:health": "bash scripts/code-health.sh",
    "joe:bundle": "bash scripts/bundle-check.sh",
    "types:supabase": "npx supabase gen types typescript --linked > types/supabase.gen.ts",
    "types:supabase:check": "npm run types:supabase && git diff --exit-code -- types/supabase.gen.ts",
    "supabase:functions:deploy": "npx supabase functions deploy create-checkout-session && npx supabase functions deploy create-billing-portal-session && npx supabase functions deploy verify-psa-cert",
    "verify": "cross-env NODE_OPTIONS=--max-old-space-size=8192 npm run typecheck && npm run typecheck:strict && npm run lint && npm run format:check && npm run test:coverage && npm run build",
    "verify:ci": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^1.49.0",
    "@stripe/stripe-js": "^9.13.0",
    "@supabase/supabase-js": "^2.112.2",
    "@tanstack/react-virtual": "^3.14.9",
    "dompurify": "^3.4.13",
    "jspdf": "^4.1.0",
    "lucide-react": "1.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "^19.2.8",
    "react-router-dom": "7.18.2",
    "recharts": "3.10.1",
    "stripe": "^22.4.0",
    "web-vitals": "^6.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.11",
    "typescript": "~6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@sentry/react": "^10.69.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --rule \"no-unused-vars: off\" --fix"
    ],
    "*.{json,yml,yaml,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "react-router": "8.3.0",
    "brace-expansion": "5.0.9"
  }
}
