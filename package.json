{
  "name": "modern-sports-intelligence",
  "private": true,
  "version": "4.3.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e",
    "build:size": "vite build && node scripts/bundle-size.cjs",
    "preview": "vite preview",
    "lint": "eslint --rule \"no-unused-vars: off\" \"**/*.{ts,tsx}\"",
    "lint:fix": "eslint --rule \"no-unused-vars: off\" \"**/*.{ts,tsx}\" --fix",
    "lint:errors": "eslint --rule \"no-unused-vars: off\" --quiet \"**/*.{ts,tsx}\"",
    "format": "prettier --write \"docs/**/*.md\" \".github/workflows/*.yml\" \"*.json\"",
    "format:check": "prettier --check \"docs/**/*.md\" \".github/workflows/*.yml\" \"*.json\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit:high": "npm audit --audit-level=high",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.release.json",
    "typecheck:strict": "tsc --noEmit -p tsconfig.strict.json",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/auth.spec.ts tests/e2e/dashboard.spec.ts tests/e2e/release-smoke.spec.ts tests/e2e/billing-checkout.spec.ts --project=chromium --workers=2",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:desktop": "playwright test --project=chromium",
    "test:e2e:mobile": "playwright test --project=Mobile Chrome",
    "test:e2e:pricing-truth": "playwright test tests/e2e/pricing-truth-coverage.spec.ts --project=chromium",
    "test:e2e:deployed": "playwright test tests/e2e/deployed-api.spec.ts --project=chromium --workers=1",
    "audit:localstorage": "node scripts/audit-localstorage.mjs",
    "verify:rls": "node scripts/rls-verify.mjs",
    "guardrail:pricing-truth": "node scripts/check-pricing-truth-guardrail.mjs",
    "ci:bundle": "node scripts/ci-bundle-gate.cjs",
    "joe": "tsx scripts/orchestrator.ts",
    "joe:batch": "tsx scripts/batch-builder.ts",
    "joe:validate": "tsx scripts/feature-validator.ts",
    "joe:diff": "tsx scripts/feature-diff.ts",
    "joe:health": "bash scripts/code-health.sh",
    "joe:bundle": "bash scripts/bundle-check.sh",
    "types:supabase": "npx supabase gen types typescript --linked > types/supabase.gen.ts",
    "types:supabase:check": "npm run types:supabase && git diff --exit-code -- types/supabase.gen.ts",
    "supabase:functions:deploy": "npx supabase functions deploy create-checkout-session && npx supabase functions deploy create-billing-portal-session",
    "verify": "npm run typecheck && npm run typecheck:strict && npm run lint && npm run format:check && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^1.49.0",
    "@stripe/stripe-js": "^9.2.0",
    "@supabase/supabase-js": "^2.103.0",
    "@tanstack/react-virtual": "^3.13.23",
    "dompurify": "^3.2.4",
    "jspdf": "^4.1.0",
    "lucide-react": "1.8.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-is": "^19.2.5",
    "react-router-dom": "^7.14.0",
    "recharts": "3.8.1",
    "stripe": "^22.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.4",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.0.2",
    "playwright": "^1.59.1",
    "prettier": "^3.8.3",
    "tsx": "^4.22.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.4"
  },
  "optionalDependencies": {
    "@sentry/react": "^10.48.0"
  }
}
