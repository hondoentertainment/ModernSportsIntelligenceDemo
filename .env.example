# =============================================================================
# Modern Sports Intelligence Demo — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# Variables prefixed with VITE_ are exposed to the browser via Vite.
# Do NOT put secret/server-only keys in VITE_ variables.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (required for authentication, database, and cloud sync)
# -----------------------------------------------------------------------------
# Project URL from your Supabase dashboard (Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous key from your Supabase dashboard (Settings > API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# Google Gemini AI (required for AI card valuations and analysis)
# -----------------------------------------------------------------------------
# API key from https://aistudio.google.com/app/apikey
# Note: vite.config.ts reads this as GEMINI_API_KEY (no VITE_ prefix) and
# injects it into the client bundle via define. You only need to set one.
GEMINI_API_KEY=AIzaSy...your-gemini-api-key

# -----------------------------------------------------------------------------
# Stripe (optional — required only for subscription billing)
# -----------------------------------------------------------------------------
# Publishable key from https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Price IDs for each subscription tier (from Stripe Products > Pricing)
VITE_STRIPE_BASIC_PRICE_ID=price_basic_example
VITE_STRIPE_PRO_PRICE_ID=price_pro_example
VITE_STRIPE_ALPHA_PRICE_ID=price_alpha_example

# -----------------------------------------------------------------------------
# PressBox API (optional — enhanced MLB news and media content)
# -----------------------------------------------------------------------------
VITE_PRESSBOX_API_KEY=your-pressbox-api-key

# -----------------------------------------------------------------------------
# Testing / CI (optional — used by Playwright and CI pipelines)
# -----------------------------------------------------------------------------
# Base URL for Playwright end-to-end tests (defaults to http://localhost:4173)
# PLAYWRIGHT_BASE_URL=http://localhost:4173

# Set to "true" in CI environments to enable strict mode and retries
# CI=true
