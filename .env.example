# Modern Sports Intelligence — Environment Variables
# Copy to .env and fill in values. Never commit .env.

# ─── Required for auth & cloud data ─────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── Optional: AI & live data ───────────────────────────────────────────
VITE_GEMINI_API_KEY=
VITE_PRESSBOX_API_KEY=

# ─── Optional: Billing (Stripe) ─────────────────────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_BASIC_PRICE_ID=
VITE_STRIPE_PRO_PRICE_ID=
VITE_STRIPE_ALPHA_PRICE_ID=

# ─── Optional: eBay (client ID only — NEVER use VITE_ for client secret) ──
# VITE_EBAY_CLIENT_ID= (for direct eBay Browse API; token exchange is server-side)

# ─── Optional: Supabase Storage ─────────────────────────────────────────
# VITE_SUPABASE_STORAGE_BUCKET=

# ─── Optional: Custom API base ──────────────────────────────────────────
# VITE_SERVER_API_BASE_URL= (absolute URL; e.g. https://api.example.com)
# VITE_FF_ENABLE_BETA_SURFACES=0  # set 1/true to expose beta surfaces in directory/search

# ─── Tier 1 real API feature flags (optional; default mock) ───────────
# VITE_FF_REAL_EBAY=1       # price charts + deal finder use eBay adapter
# VITE_FF_REAL_PSA=1        # PSA cert lookup via /api/grading/psa/cert
# VITE_FF_REAL_BGS=0
# VITE_FF_REAL_SPORTS=0
# VITE_FF_REAL_COMC=0

# ─── Optional: Error reporting (production) ─────────────────────────────
# POST endpoint for error beacon; leave empty to disable.
# VITE_ERROR_REPORTING_URL=
# VITE_SENTRY_DSN= (optional; when set, init lib/sentry and errors go to Sentry)
# Ops reference: docs/MONITORING.md (GET /api/health, errors, rate limits).

# ─── Server-only (Vercel / Node — not VITE_): API rate limits ───────────
# ALLOWED_ORIGIN=https://your-app.vercel.app   # CORS for /api/ai + /api/market/ebay (required on prod custom domain; else https://$VERCEL_URL). Allows Content-Type + Authorization (Bearer JWT).
# RATE_LIMIT_AI_MAX_PER_MINUTE=30
# RATE_LIMIT_EBAY_MAX_PER_MINUTE=60
# RATE_LIMIT_DISABLED=1   # local only — 1 or true disables throttling on ai + ebay routes

# GEMINI_API_KEY=         # server: api/ai/generate.ts (never VITE_)

# PSA_API_KEY=            # server: api/grading/psa/cert.ts + Edge Function verify-psa-cert

# ─── Protected API routes (/api/ai/generate, /api/market/ebay) ───────────
# Client sends Supabase session JWT (Authorization: Bearer) when signed in.
# On Vercel, set the same project URL + anon key the browser uses:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# Optional: MSI_SERVER_API_SECRET=long-random (Bearer match for automation — never VITE_)
# Local dev only (never production): MSI_API_AUTH_DISABLED=1

# ─── Stripe webhook + Checkout (Vercel server only) ─────────────────────
# STRIPE_WEBHOOK_SECRET=whsec_...   # Dashboard → Webhooks → signing secret
# STRIPE_SECRET_KEY=sk_live_... or sk_test_...  # required in production for webhook handler
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=   # never VITE_; dedupe table + profiles PATCH
# STRIPE_WEBHOOK_FAIL_CLOSED=1  # optional; force 503 when idempotency DB unavailable (recommended staging+prod)
#
# Same Stripe Price IDs as billing (server-side copy for webhook tier mapping):
# STRIPE_BASIC_PRICE_ID=
# STRIPE_PRO_PRICE_ID=
# STRIPE_ALPHA_PRICE_ID=

# ─── Security: Never use VITE_ for server secrets ─────────────────────
# VITE_ vars are bundled into the client and visible in the browser.
# Bearer tokens, client credentials, API secrets (e.g. Twitter, Reddit, eBay
# client secret) must use server-side API routes (api/*) with process.env only.
# See .cursor/skills/security/SKILL.md and docs/PAYMENT_SECURITY.md.
